+        /* Apache can close the dummy socket normally - it's a real socketpair */
+        /* We just need to clean up our QUIC SSL objects here */
+        h3_quic_conn_state_t *qcs = ap_get_module_config(c->conn_config, &http3_module);
+        if (qcs && qcs->ssl_conn) {
+            ap_log_cerror(APLOG_MARK, APLOG_DEBUG, 0, c,
+                          "h3_hook_pre_close_connection: cleaning up QUIC SSL connection");
+            SSL_free(qcs->ssl_conn);
+            qcs->ssl_conn = NULL;
+        }
+
+        return OK;
+    }
+    return DECLINED;

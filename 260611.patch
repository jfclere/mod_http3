+static int h3_hook_pre_close_connection(conn_rec* c)
+{
+    const char* is_mod_http3 = apr_table_get(c->notes, "IS_mod_http3");
+    if (is_mod_http3) {
+        ap_log_cerror(APLOG_MARK, APLOG_INFO, 0, c,
+                      "h3_hook_pre_close_connection: QUIC connection closing");

if(CPACK_GENERATOR STREQUAL "RPM")
  set(CPACK_COMPONENTS_ALL rpm)
  set(CPACK_RPM_FILE_NAME "@PROJECT_NAME@-@PROJECT_VERSION@.@CMAKE_SYSTEM_PROCESSOR@.rpm")
elseif(CPACK_GENERATOR STREQUAL "DEB")
  set(CPACK_COMPONENTS_ALL deb)
  set(CPACK_DEBIAN_FILE_NAME "@PROJECT_NAME@_@PROJECT_VERSION@_@CPACK_DEBIAN_PACKAGE_ARCHITECTURE@.deb")
elseif(CPACK_GENERATOR STREQUAL "TGZ" OR CPACK_GENERATOR STREQUAL "ZIP")
  set(CPACK_COMPONENTS_ALL generic)
else()
  message(FATAL_ERROR "Unsupported binary package generator: ${CPACK_GENERATOR}")
endif()
